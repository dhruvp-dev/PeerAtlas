# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=local:local-peer-peeratlas

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Better Auth Configuration
BETTER_AUTH_SECRET=your_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# Admin Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_password_here

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Timetable PDF Configuration (Optional: set custom Convex storage URL or external PDF link)
# If left unset, defaults to local static asset: /assets/College of Engineering - Pune Navi Mumbai Campus Theory Timetable Winter - 2026.pdf
# NEXT_PUBLIC_TIMETABLE_PDF_URL=https://your-convex-app.convex.cloud/api/storage/your-storage-id
